    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "<color=#8C5826>◆抽奖规则：</color>\n活动期间每抽奖1次可获取契约值，有概率触发暴击效果，达到对应进度可领取限定使魔，活动结束后契约值清空。\n<color=#8C5826>◆道具回收：</color>\n活动结束后，使命必达先生召唤器​，使命成立币会被回收为金币。\n<color=#8C5826>◆使命必达先生召唤器倍率：</color>\n1倍:85%\n2倍:8.3%\n3倍:4%\n5倍:1.5%\n10倍:0.6%\n20倍:0.3%\n30倍:0.2%\n50倍:0.1%"
  m_languageId: 260663044
  m_language: 2
  m_autoChangeLanguage: 1
  bestFitWrapFirst: 0
