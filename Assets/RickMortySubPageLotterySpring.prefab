    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "<color=#8C5826>◆抽奖规则：</color>\n活动期间每抽奖1次可获取幸运值，幸运值到达400必定获得超级大奖，如果提前抽到超级大奖，那么幸运值将重置。\n\n<color=#8C5826>◆道具回收：</color>\n活动结束后，人格芯片，记忆储存装置会被回收为金币。"
  m_languageId: 260657020
  m_language: 2
  m_autoChangeLanguage: 1
  bestFitWrapFirst: 0
