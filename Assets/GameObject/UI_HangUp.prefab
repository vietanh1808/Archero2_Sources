    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "<color=#8C5826>◆游猎掉落：</color>\n游猎时获得物品概率详情\n------------------\n<color=#524236>金币:100%</color>\n<color=#524236>经验:100%</color>\n------------------\n<color=#524236>秘语者长弓:0.79%</color>\n<color=#524236>光束法杖:0.79%</color>\n<color=#524236>角斗士拳套:0.79%</color>\n<color=#524236>秘语者护甲:0.79%</color>\n<color=#524236>回响护甲:0.79%</color>\n<color=#524236>角斗士护甲:0.79%</color>\n<color=#524236>秘语者之靴:0.79%</color>\n<color=#524236>回响之靴:0.79%</color>\n<color=#524236>角斗士之靴:0.79%</color>\n<color=#524236>秘语者头盔:0.79%</color>\n<color=#524236>回响头盔:0.79%</color>\n<color=#524236>角斗士头盔:0.79%</color>\n<color=#524236>秘语者戒指:0.79%</color>\n<color=#524236>回响戒指:0.79%</color>\n<color=#524236>角斗士戒指:0.79%</color>\n<color=#524236>秘语者护符:0.79%</color>\n<color=#524236>回响护符:0.79%</color>\n<color=#524236>角斗士护符:0.79%</color>\n------------------\n<color=#524236>武器卷轴:11.90%</color>\n<color=#524236>护甲卷轴:11.90%</color>\n<color=#524236>头盔卷轴:11.90%</color>\n<color=#524236>戒指卷轴:11.90%</color>\n<color=#524236>护符卷轴:11.90%</color>\n<color=#524236>靴子卷轴:11.90%</color>\n-----------------\n<color=#524236>旋转锯盘:0.65%</color>\n<color=#524236>旋转加速:0.65%</color>\n<color=#524236>游龙飞剑:0.65%</color>\n<color=#524236>飞剑弹射:0.65%</color>\n<color=#524236>精灵连射:0.65%</color>\n<color=#524236>精灵连携:0.65%</color>\n<color=#524236>锋锐之箭:0.65%</color>\n<color=#524236>巨流星:0.65%</color>\n<color=#524236>魔药引力:0.65%</color>\n<color=#524236>焰毒之印:0.65%</color>\n<color=#524236>霜雷之印:0.65%</color>\n<color=#524236>旋转球:0.65%</color>\n<color=#524236>痛苦之环:0.65%</color>\n<color=#524236>时之剑:0.65%</color>\n<color=#524236>飞剑魔药:0.65%</color>\n<color=#524236>近战精灵:0.65%</color>\n<color=#524236>治愈精灵:0.65%</color>\n<color=#524236>箭雨术:0.65%</color>\n<color=#524236>时之星:0.65%</color>\n<color=#524236>怒之星:0.65%</color>\n<color=#524236>焰毒之触:0.65%</color>\n<color=#524236>霜雷之触:0.65%</color>"
  m_languageId: 250722002
  m_language: 2
